{
  "name": "@zaweli/template-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Moteur de templates ZAWELI : manifeste, DSL de champs, validation du contenu.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@zaweli/shared-types": "workspace:^",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@zaweli/config": "workspace:^",
    "eslint": "10.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
