# Espace d'administration (admin.zaweli.store). Copier en .env.local pour le développement.
# Toutes ces valeurs sont PUBLIQUES (intégrées au code livré) : aucun secret ici.

# API ZAWELI. Ajouter https://admin.zaweli.store à CORS_ORIGINS côté API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Auth : URL du projet et clé publique (anon / publishable).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Données de démonstration générées (développement seulement, ignoré en production).
# NEXT_PUBLIC_ADMIN_DEMO=1
