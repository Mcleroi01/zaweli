# =====================================================================
# ZAWELI · API — variables d'environnement
#
# Copier ce fichier en apps/api/.env puis remplir les valeurs.
# Une clé facultative reste COMMENTÉE tant qu'elle n'a pas de valeur :
# « CLE= » vide est refusé au démarrage.
#   - En local, `pnpm env:local` génère .env à partir du Supabase local.
#   - En production (NODE_ENV=production), .env n'est PAS lu : poser ces
#     variables dans le panneau de l'hébergeur (Hostinger → Node.js → Variables).
# L'API refuse de démarrer si une valeur est absente ou invalide
# (src/config/env.ts). Ne jamais commiter le vrai .env.
# =====================================================================

# --- Général ----------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
APP_VERSION=0.0.0

# --- Base de données (OBLIGATOIRE) ------------------------------------
# Rôle dédié de l'API (zaweli_api_login), jamais « postgres » en production.
# Supabase → Connect → Session pooler (Hostinger ne joint pas toujours l'adresse IPv6 directe).
DATABASE_URL=postgresql://zaweli_api_login.VOTRE_PROJET:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10

# --- Supabase (OBLIGATOIRE : SUPABASE_URL) ----------------------------
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
# Clé secrète (service role) : envoi de photos, suspension des comptes.
# Facultative, mais sans elle les photos sont indisponibles. Côté serveur seulement.
# SUPABASE_SECRET_KEY=

# --- Adresses publiques -----------------------------------------------
# Site public : liens partagés /g/<lien> et retours de paiement.
PUBLIC_WEB_URL=https://zaweli.store
# API publique : webhooks MbiyoPay. Obligatoire en production avec une clé MbiyoPay.
PUBLIC_API_URL=https://api.zaweli.store
# Origines autorisées (CORS), séparées par des virgules. Obligatoire en production.
CORS_ORIGINS=https://zaweli.store,https://www.zaweli.store,https://admin.zaweli.store

# En-tête du CDN donnant le pays du visiteur (pré-remplit le pays d'un compte).
# Cloudflare : cf-ipcountry. Laisser vide pour désactiver.
GEO_COUNTRY_HEADER=cf-ipcountry

# --- Paiements mobile money (MbiyoPay, docs/12) -----------------------
# Sans clé : paiement indisponible, le reste fonctionne.
# Clé « Test » → MBIYOPAY_MODE=sandbox ; clé « Live » → MBIYOPAY_MODE=live.
# MBIYOPAY_API_KEY=
MBIYOPAY_MODE=sandbox
MBIYOPAY_BASE_URL=https://dashboard.mbiyo.africa/api/v1
# Secret saisi dans MbiyoPay → Paramètres → Webhooks (8 caractères min.).
# Obligatoire en production dès qu'une clé est fournie.
# MBIYOPAY_WEBHOOK_SECRET=
# Revérification des paiements en attente, en secondes (0 : désactivée).
PAYMENTS_RECONCILE_SECONDS=120

# --- Musique (Audius) -------------------------------------------------
# La recherche fonctionne sans clé ; la clé d'application est facultative.
AUDIUS_API_URL=https://api.audius.co/v1
# AUDIUS_API_KEY=

# --- Aide à l'écriture (OpenRouter) -----------------------------------
# Sans clé ou sans modèle : fonction indisponible.
# Modèle au format « fournisseur/modèle », ex. anthropic/claude-haiku-5-5.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- E-mails transactionnels ------------------------------------------
# Ex. smtps://utilisateur:motdepasse@smtp.hostinger.com:465
# Vide : les e-mails sont seulement écrits dans le journal.
# SMTP_URL=
MAIL_FROM=Zaweli <bonjour@zaweli.store>

# --- Mandataires (proxy) -----------------------------------------------
# Nombre de mandataires devant l'API, pour lire la vraie IP du visiteur
# (limites de débit). Hostinger (CDN + serveur web) : 2. Local : laisser vide.
# TRUST_PROXY=2
